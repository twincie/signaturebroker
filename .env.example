# The API listens here and Vite proxies /api to it. Set only one of these two:
# PORT wins if both are present, so leaving both is how the port silently
# disagrees with what you think you configured. Deployment platforms such as
# Render and Railway inject PORT themselves, which is why it takes priority.
SIGNATURE_PORT=3002

# The Vite dev server's port. The built site is served by the API instead, so
# this only matters for local development.
FRONTEND_PORT=5173
NODE_ENV=production
ADMIN_API_KEY=replace-with-a-long-random-secret
ADMIN_USERNAME=insurance
ADMIN_PASSWORD=replace-this-before-production
RESEND_API_KEY=re_xxxxxxxxx
# Resend's onboarding sender is suitable for initial testing. Replace it with
# quotes@your-verified-domain.com after verifying your production domain.
QUOTE_EMAIL_FROM=Signature Insurance Brokers Limited <onboarding@resend.dev>
QUOTE_EMAIL_TO=signatureinsurancebrokersltd@gmail.com
QUOTE_PROVIDER_URL=https://partner-api.example.com
QUOTE_PROVIDER_API_KEY=replace-with-partner-api-key
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/signaturebroker?retryWrites=true&w=majority

# Logging verbosity: error, warn, info (default), or debug.
# Use debug to trace every request, provider call, pricing run and email.
LOG_LEVEL=info
# Set to 1 to drop ANSI colour codes, which is useful for log aggregators.
NO_COLOR=0
