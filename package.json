{
  "name": "signature-broker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:api": "node --watch backend/server.js",
    "build": "vite build",
    "start": "node backend/server.js",
    "test": "node --test",
    "lint": "prettier --check \"**/*.{js,mjs,css,html,json,md}\"",
    "format": "prettier --write \"**/*.{js,mjs,css,html,json,md}\"",
    "backup": "node scripts/backup.js backup",
    "preview": "vite preview --host 0.0.0.0",
    "preview:email": "node scripts/preview-email.js",
    "dev:web": "vite --host 0.0.0.0"
  },
  "dependencies": {
    "dotenv": "^18.0.1",
    "mongodb": "^7.6.0",
    "vite": "^7.1.5"
  },
  "devDependencies": {
    "prettier": "^3.3.3"
  }
}
